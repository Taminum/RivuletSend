{
  "name": "@p2p/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "RivuletSend — peer-to-peer file transfer",
  "author": "RivuletSend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node build/gen-icons.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rivuletsend.app",
    "productName": "RivuletSend",
    "icon": "build/icon.ico",
    "files": ["main.js", "preload.js", "setup.html", "assets/**/*"],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RivuletSend",
      "artifactName": "RivuletSend-Setup.${ext}"
    },
    "portable": {
      "artifactName": "RivuletSend-Portable.${ext}"
    }
  }
}
